# Copy to scripts/release.local.env.
# This file is intentionally safe to commit; release.local.env is ignored.

### Object storage (Cloudflare R2 或腾讯云 COS，S3 兼容)
# 二选一：R2（forcePathStyle=true, region=auto）或 COS（forcePathStyle=false, region=真实地域）
S3_BUCKET=legalwork            # COS 需含 appid 后缀，如 legalwork-1250000000
S3_ENDPOINT=https://<endpoint> # R2: https://<account-id>.r2.cloudflarestorage.com；COS: https://cos.<region>.myqcloud.com
S3_REGION=auto                 # R2: auto；COS: ap-guangzhou 等真实地域
S3_FORCE_PATH_STYLE=true       # R2: true；COS: false（虚拟主机风格）
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>

# Public download domain used in latest.json and electron-updater metadata.
# R2: 用 R2 自定义域名；COS: 用 COS 默认域名或已备案的 CDN 域名。
R2_PUBLIC_BASE_URL=https://download.example.com
R2_RELEASE_PREFIX=legalwork

# Default release channel for scripts when --channel is not passed.
# The project default is frontier; pass --stable or --channel stable for stable releases.
RELEASE_CHANNEL=frontier

### Automatic error reporting → GitHub issues (see docs/error-reporting.md)
# Minimal-privilege token: only issues:write on the report repo. Bundled into
# the packaged app at build time; do NOT use your main token. Empty = reporting off.
LEGALWORK_ERROR_REPORT_GITHUB_REPO=your-account/legalwork-reports
LEGALWORK_ERROR_REPORT_GITHUB_TOKEN=ghp_your_minimal_token
LEGALWORK_ERROR_REPORT_GITHUB_LABEL=bug-report
# Alternative to GitHub: any POST endpoint. Leave empty if using GitHub.
# LEGALWORK_ERROR_REPORT_URL=

### macOS signing and notarization
P12_PATH=/path/to/develop-id.p12
P12_PASSWORD=<p12-password>
P8_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
KEY_ID=<apple-key-id>
ISSUER=<apple-issuer-uuid>
